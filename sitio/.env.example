# URL del web-api. En desarrollo se usa el proxy de Vite (/api → http://localhost:8081).
VITE_API_URL=/api
# Cloudflare Turnstile. Esta es la llave de PRUEBA invisible (siempre aprueba). Reemplazar en producción.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000BB
# URL pública del sitio (canonical, Open Graph, sitemap)
VITE_SITIO_URL=http://localhost:5173
